<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cultiveau_roles.AideSystray">
        <div class="o_cultiveau_aide_systray">
            <a href="#" class="o_cultiveau_aide_bouton" role="button" title="Le tuto de cette page" t-on-click.prevent="ouvrir" aria-label="Tuto de cette page">
                <span class="o_cultiveau_aide_rond">?</span><span class="o_cultiveau_aide_libelle d-none d-lg-inline">Tuto</span>
            </a>
        </div>
    </t>
    <t t-name="cultiveau_roles.AideDialog">
        <Dialog title="props.aide.nom" size="'lg'" contentClass="'o_cultiveau_aide_dialog'">
            <div class="o_cultiveau_aide_video">
                <div t-if="video and estYoutube" class="o_cultiveau_aide_iframe">
                    <iframe t-att-src="videoEmbed" allow="autoplay; encrypted-media; fullscreen" allowfullscreen="allowfullscreen" frameborder="0"/>
                </div>
                <video t-elif="video" class="o_cultiveau_aide_mp4" t-att-src="video" controls="controls" autoplay="autoplay" playsinline="playsinline"/>
                <div t-else="" class="o_cultiveau_aide_player">
                    <div class="o_cultiveau_aide_scene">
                        <div class="o_cultiveau_aide_marque">CULTIVEAU</div>
                        <div class="o_cultiveau_aide_titre" t-esc="props.aide.nom"/>
                        <div class="o_cultiveau_aide_caption" t-esc="segmentCourant || props.aide.resume"/>
                    </div>
                    <div class="o_cultiveau_aide_barre"><span t-attf-style="width: {{ progression }}%;"/></div>
                    <div class="o_cultiveau_aide_controls">
                        <button class="btn btn-sm o_cultiveau_aide_play" t-if="!state.lecture and parleSupporte" t-on-click="jouer">
                            <i class="fa fa-play me-1"/><t t-esc="state.termine ? 'Revoir le tuto' : 'Lire le tuto'"/>
                        </button>
                        <button class="btn btn-sm o_cultiveau_aide_play" t-if="state.lecture" t-on-click="pause"><i class="fa fa-pause me-1"/>Pause</button>
                        <span class="o_cultiveau_aide_compteur" t-if="segments.length">Étape <t t-esc="etapeAffichee"/> / <t t-esc="segments.length"/></span>
                        <span class="o_cultiveau_aide_muet small" t-if="!parleSupporte">Le son n'est pas disponible ici : le tuto est écrit ci-dessous.</span>
                    </div>
                </div>
            </div>

            <p t-if="!props.aide.precis" class="text-muted small mb-2 mt-3"><i class="fa fa-info-circle me-1"/>Cette page n'a pas encore son tuto : voici les gestes qui servent partout.</p>

            <div t-if="props.aide.etapes" class="o_cultiveau_aide_bloc">
                <h5>Pas à pas</h5>
                <div class="o_cultiveau_aide_etapes" t-out="etapesHtml"/>
            </div>
            <div t-if="props.aide.texte" class="o_cultiveau_aide_bloc">
                <h5>Par où commencer</h5>
                <div t-out="texteHtml"/>
            </div>
            <div t-if="props.aide.pieges" class="o_cultiveau_aide_bloc o_cultiveau_aide_pieges">
                <h5>À ne pas faire</h5>
                <div t-out="piegesHtml"/>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="fermer">Compris</button>
                <button t-if="props.aide.editable" class="btn btn-secondary" t-on-click="modifier">Modifier ce tuto</button>
            </t>
        </Dialog>
    </t>
</templates>
