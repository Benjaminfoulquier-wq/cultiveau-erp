<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="type_entretien" model="fleet.service.type">
            <field name="name">Entretien (vidange, révision)</field>
            <field name="category">service</field>
        </record>
        <record id="type_controle_technique" model="fleet.service.type">
            <field name="name">Contrôle technique</field>
            <field name="category">service</field>
        </record>
        <record id="type_pneus" model="fleet.service.type">
            <field name="name">Pneus</field>
            <field name="category">service</field>
        </record>
        <record id="type_reparation" model="fleet.service.type">
            <field name="name">Réparation</field>
            <field name="category">service</field>
        </record>
        <record id="type_assurance" model="fleet.service.type">
            <field name="name">Assurance</field>
            <field name="category">contract</field>
        </record>

        <record id="cron_alertes" model="ir.cron">
            <field name="name">Cultiveau : échéances des véhicules</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_cultiveau_alertes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
    <function model="fleet.vehicle" name="_cultiveau_preparer"/>
</odoo>
