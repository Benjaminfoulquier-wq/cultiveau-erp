<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_cultiveau" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.cultiveau</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="cultiveau_alerte != 'depasse'"><i class="fa fa-exclamation-triangle me-1" title="Échéance"/>Échéance dépassée : <field name="cultiveau_prochaine" class="d-inline"/></div>
                <div class="alert alert-warning mb-0" role="alert" invisible="cultiveau_alerte != 'bientot'"><i class="fa fa-calendar me-1" title="Échéance"/>Échéance proche : <field name="cultiveau_prochaine" class="d-inline"/></div>
                <field name="cultiveau_alerte" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="Le camion dans l'équipe">
                    <group>
                        <field name="cultiveau_user_id" widget="many2one_avatar_user"/>
                        <field name="cultiveau_ct_prochain"/>
                        <field name="cultiveau_entretien_date"/>
                    </group>
                    <group>
                        <field name="cultiveau_entretien_km"/>
                        <field name="cultiveau_intervalle_km"/>
                        <field name="cultiveau_carburant_mois" widget="monetary"/>
                        <field name="cultiveau_carburant_annee" widget="monetary"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_list_cultiveau" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.cultiveau</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="cultiveau_user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="odometer" optional="show"/>
                <field name="cultiveau_prochaine" optional="show"/>
                <field name="cultiveau_alerte" widget="badge" decoration-danger="cultiveau_alerte == 'depasse'" decoration-warning="cultiveau_alerte == 'bientot'" decoration-success="cultiveau_alerte == 'ok'" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_view_form_flotte" model="ir.ui.view">
        <field name="name">hr.expense.form.flotte</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="cultiveau_vehicule_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- la page du téléphone : le camion du conducteur -->
    <template id="moi_camion" inherit_id="cultiveau_rh.moi" name="Mon espace : mon camion">
        <xpath expr="//section[@id='frais']" position="after">
            <section class="carte" id="camion" t-if="d.get('camion')">
                <h2><i class="fa fa-truck"/> Mon camion · <t t-esc="d['camion']['plaque'] or d['camion']['nom']"/></h2>
                <form method="post" action="/moi/compteur" class="formulaire">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <label>Compteur (dernier relevé : <t t-esc="'{:,.0f}'.format(d['camion']['km']).replace(',', ' ')"/> km)
                        <input type="text" inputmode="numeric" name="km" required="required" placeholder="Kilométrage affiché"/>
                    </label>
                    <button class="bouton plein"><i class="fa fa-tachometer"/> Enregistrer le compteur</button>
                </form>
                <div class="liste" t-if="d['camion']['echeances']">
                    <div t-foreach="d['camion']['echeances'][:4]" t-as="e" class="ligne">
                        <div class="texte"><t t-esc="e['nom']"/><div class="petit gris" t-esc="e['quand']"/></div>
                        <span t-att-class="'pastille ' + ('rouge' if e['etat'] == 'depasse' else 'ambre' if e['etat'] == 'bientot' else 'vert')" t-esc="e['reste']"/>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
