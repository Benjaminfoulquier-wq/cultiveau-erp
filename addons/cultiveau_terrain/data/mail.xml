<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="modele_mail_bon" model="mail.template">
            <field name="name">Bon d'intervention : envoi au client</field>
            <field name="model_id" ref="model_cultiveau_bon"/>
            <field name="subject">Bon d'intervention {{ object.name }} — {{ object.company_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="report_template_ids" eval="[(4, ref('action_report_bon'))]"/>
            <field name="body_html" type="html">
<div>
    <p>Bonjour,</p>
    <p>Vous trouverez ci-joint le bon de l'intervention du <t t-out="format_date(object.date)"/> sur votre installation
       <t t-if="object.installation_id"><t t-out="object.installation_id.name"/></t>, signé sur place.</p>
    <p t-if="object.recommandations">Nos recommandations : <t t-out="object.recommandations"/></p>
    <p>Bonne journée,<br/><t t-out="object.company_id.name"/>, membre du réseau Cultiveau</p>
</div>
            </field>
        </record>
    </data>
</odoo>
