<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_cultiveau" model="ir.ui.view">
        <field name="name">sale.order.form.cultiveau</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="cultiveau_installation_id" context="{'default_partner_id': partner_id}"/>
                <field name="cultiveau_type_systeme"/>
                <field name="cultiveau_surface_ha" invisible="not cultiveau_installation_id"/>
                <field name="cultiveau_dimensionnement" invisible="not cultiveau_dimensionnement"/>
                <field name="cultiveau_analyse_validee" invisible="not cultiveau_installation_id"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="not cultiveau_installation_id or cultiveau_analyse_validee">
                    Analyse des besoins (A1.1) non validée avec l'exploitant : le référentiel la demande avant tout dimensionnement (§ 3.2).
                </div>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_creer_installation" type="object" string="Créer l'installation" invisible="cultiveau_installation_id or not partner_id"/>
                <button name="action_inserer_nomenclature" type="object" string="Insérer une nomenclature" invisible="state not in ('draft', 'sent')"/>
                <button name="action_enregistrer_nomenclature" type="object" string="Enregistrer en nomenclature" invisible="not order_line"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-it">cultiveau_sous_lot</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='display_type']" position="after">
                <field name="cultiveau_sous_lot" column_invisible="True"/>
                <field name="cultiveau_nomenclature_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/control/create[@name='add_section_control']" position="after">
                <create name="add_sous_lot_control" string="Ajouter un sous-lot" context="{'default_display_type': 'line_section', 'default_cultiveau_sous_lot': True}"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Lots et sous-totaux" name="lots_cultiveau">
                    <field name="cultiveau_nb_lots" invisible="1"/>
                    <field name="cultiveau_recap_lots" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_template_form_cultiveau" model="ir.ui.view">
        <field name="name">sale.order.template.form.cultiveau</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <field name="number_of_days" position="after">
                <field name="cultiveau_type_systeme"/>
            </field>
        </field>
    </record>
</odoo>
