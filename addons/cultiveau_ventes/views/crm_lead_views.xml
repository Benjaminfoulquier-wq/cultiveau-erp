<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_cultiveau" model="ir.ui.view">
        <field name="name">crm.lead.form.cultiveau</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Irrigation" name="cultiveau">
                    <group>
                        <group>
                            <field name="cultiveau_installation_id" context="{'default_partner_id': partner_id}"/>
                            <field name="cultiveau_type_systeme"/>
                            <field name="cultiveau_surface_ha"/>
                        </group>
                        <group>
                            <field name="cultiveau_urgence"/>
                            <field name="cultiveau_origine"/>
                            <field name="cultiveau_reference_appel"/>
                        </group>
                    </group>
                    <button name="action_creer_installation" type="object" string="Créer l'installation (ouvrir l'analyse des besoins)" class="btn btn-primary"
                            invisible="cultiveau_installation_id or not partner_id"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search_cultiveau" model="ir.ui.view">
        <field name="name">crm.lead.search.cultiveau</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="cultiveau_assistant" string="Venues de l'assistant téléphonique" domain="[('cultiveau_origine', '=', 'assistant')]"/>
                <filter name="cultiveau_urgentes" string="Urgentes" domain="[('cultiveau_urgence', 'in', ('immediate', 'journee'))]"/>
            </xpath>
        </field>
    </record>
</odoo>
