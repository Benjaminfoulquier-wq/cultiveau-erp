<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_checklist_lecture" model="ir.rule">
        <field name="name">Checklists : les miennes et celles du réseau</field>
        <field name="model_id" ref="model_cultiveau_checklist_modele"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="regle_checklist_ecriture" model="ir.rule">
        <field name="name">Checklists : on ne modifie que les siennes</field>
        <field name="model_id" ref="model_cultiveau_checklist_modele"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="regle_checklist_equipe" model="ir.rule">
        <field name="name">Checklists : l'équipe Cultiveau gère celles du réseau</field>
        <field name="model_id" ref="model_cultiveau_checklist_modele"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('cultiveau_base.group_equipe'))]"/>
    </record>
    <record id="regle_checklist_ligne" model="ir.rule">
        <field name="name">Points de checklist : comme le modèle</field>
        <field name="model_id" ref="model_cultiveau_checklist_modele_ligne"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_point_bon" model="ir.rule">
        <field name="name">Points du bon : par société</field>
        <field name="model_id" ref="model_cultiveau_checklist_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
