<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_avis_list" model="ir.ui.view">
        <field name="name">cultiveau.referentiel.avis.list</field>
        <field name="model">cultiveau.referentiel.avis</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="genre"/>
                <field name="mots_cles"/>
                <field name="types" optional="show"/>
                <field name="section"/>
                <field name="page" optional="show"/>
                <field name="niveau" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_avis_form" model="ir.ui.view">
        <field name="name">cultiveau.referentiel.avis.form</field>
        <field name="model">cultiveau.referentiel.avis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="status">Une règle = des mots cherchés dans le devis, une note qui cite la section du référentiel. Le niveau suit le § 1.4.3 : exigence réglementaire, exigence technique, recommandation, ordre de grandeur. Là où le référentiel se tait, dites-le dans la note.</div>
                    <div class="oe_title"><h1><field name="name" placeholder="Filtre à sable : batterie et vitesse"/></h1></div>
                    <group>
                        <group>
                            <field name="genre"/>
                            <field name="mots_cles" invisible="genre == 'toujours'"/>
                            <field name="si_present" invisible="genre != 'absence'"/>
                            <field name="types"/>
                        </group>
                        <group>
                            <field name="section"/>
                            <field name="page"/>
                            <field name="niveau"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="La note telle qu'elle s'écrira sur le devis">
                        <field name="texte" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_avis" model="ir.actions.act_window">
        <field name="name">Avis du référentiel sur les devis</field>
        <field name="res_model">cultiveau.referentiel.avis</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Aucune règle</p><p>Les règles du réseau se chargent avec le module ; ajoutez les vôtres.</p></field>
    </record>
</odoo>
