<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Pas d'inscription publique : les comptes sont créés par l'équipe. La réinitialisation du mot de passe reste possible. -->
        <function model="ir.config_parameter" name="set_param" eval="['auth_signup.invitation_scope', 'b2b']"/>
        <function model="ir.config_parameter" name="set_param" eval="['auth_signup.reset_password', 'True']"/>
        <!-- Les couleurs des e-mails et le nom du robot interne de la messagerie : ceux du réseau, réappliqués à chaque mise à jour. -->
        <function model="res.company" name="write" eval="[[ref('base.main_company')], {'email_primary_color': '#183840', 'email_secondary_color': '#0b8aa3'}]"/>
        <function model="res.partner" name="write" eval="[[ref('base.partner_root')], {'name': 'Assistant Cultiveau'}]"/>
    </data>
    <data noupdate="1">
        <!-- Le logo de la société principale : Cultiveau. -->
        <record id="base.main_company" model="res.company">
            <field name="name">Cultiveau</field>
            <field name="logo" type="base64" file="cultiveau_marque/static/src/img/logo.png"/>
        </record>
    </data>
</odoo>
