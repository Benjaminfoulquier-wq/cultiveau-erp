<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_documents" model="ir.ui.view">
        <field name="name">account.move.form.cultiveau.documents</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_relancer" type="object" string="Rappel au client"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state not in ('not_paid', 'partial')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="cultiveau_jours_retard" invisible="not cultiveau_jours_retard" decoration-danger="cultiveau_jours_retard"/>
                <field name="cultiveau_relances" invisible="not cultiveau_relances"/>
            </xpath>
        </field>
    </record>
</odoo>
