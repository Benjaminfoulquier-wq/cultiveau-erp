<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_relance_devis" model="ir.cron">
        <field name="name">Cultiveau : relance des devis sans réponse</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_relancer_devis()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_relance_factures" model="ir.cron">
        <field name="name">Cultiveau : rappel des factures en retard</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_relancer_factures()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
