<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_cultiveau" inherit_id="sale.report_saleorder_document" name="Cultiveau : devis">
        <!-- Le projet : installation, type, surface, dimensionnement. -->
        <xpath expr="//div[@id='informations']" position="after">
            <div t-if="doc.cultiveau_installation_id" class="mb-3 p-2 rounded" style="background: #f3f7f8; font-size: 11px;" name="projet_cultiveau">
                <strong>Votre projet :</strong> <span t-field="doc.cultiveau_installation_id.name"/>
                <t t-if="doc.cultiveau_type_systeme"> — <span t-field="doc.cultiveau_type_systeme"/></t>
                <t t-if="doc.cultiveau_surface_ha"> — <span t-field="doc.cultiveau_surface_ha"/> ha</t>
                <t t-if="doc.cultiveau_dimensionnement"> — <span t-field="doc.cultiveau_dimensionnement"/></t>
            </div>
        </xpath>
        <!-- L'acompte et le bon pour accord, tant que le devis n'est pas signé. -->
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div t-if="doc.state in ('draft', 'sent') and not env.context.get('proforma')" class="row mt-4 avoid-page-break-inside" name="accord_cultiveau">
                <div class="col-6" style="font-size: 11px;">
                    <p t-if="doc.cultiveau_acompte_pct">
                        <strong>Acompte à la commande :</strong> <t t-out="'%g' % doc.cultiveau_acompte_pct"/> %, soit
                        <span t-field="doc.cultiveau_acompte_montant" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/> TTC.
                        Le solde à la mise en service.
                    </p>
                    <p t-if="doc.payment_term_id">Conditions de règlement : <span t-field="doc.payment_term_id.name"/>.</p>
                    <p t-if="doc.require_signature">Vous pouvez aussi signer ce devis en ligne depuis l'e-mail reçu.</p>
                </div>
                <div class="col-6">
                    <div class="border rounded p-2" style="min-height: 110px; font-size: 11px;">
                        <strong>Bon pour accord</strong><br/>
                        Date : ………………………… Nom : …………………………………<br/>
                        <span class="text-muted">Signature précédée de la mention « lu et approuvé »</span>
                    </div>
                </div>
            </div>
        </xpath>
        <!-- Les sous-lots : leur sous-total, puis le total du lot qui les contient (le sous-total par section vient d'Odoo). -->
        <xpath expr="//t[@t-set='current_subtotal'][@t-value='current_subtotal + line.price_subtotal']" position="after">
            <t t-set="lot_total" t-value="(lot_total or 0) + line.price_subtotal"/>
        </xpath>
        <xpath expr="//t[@t-set='current_section'][@t-value='line']" position="after">
            <t t-if="line.display_type == 'line_section' and not line.cultiveau_sous_lot">
                <t t-set="lot_courant" t-value="line"/>
                <t t-set="lot_total" t-value="0"/>
                <t t-set="lot_a_sous_lots" t-value="False"/>
            </t>
            <t t-if="line.display_type == 'line_section' and line.cultiveau_sous_lot">
                <t t-set="lot_a_sous_lots" t-value="True"/>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_section_line']" position="attributes">
            <attribute name="t-attf-style">{{ 'padding-left: 18px; font-weight: 600; font-style: italic; font-size: 95%;' if line.cultiveau_sous_lot else '' }}</attribute>
        </xpath>
        <xpath expr="//t[@t-set='current_section'][@t-value='None']" position="before">
            <t t-set="section_fermee" t-value="current_section"/>
        </xpath>
        <xpath expr="//td[@name='td_section_subtotal']" position="replace">
            <td name="td_section_subtotal" colspan="99" t-attf-style="{{ 'font-size: 95%; font-style: italic;' if section_fermee and section_fermee.cultiveau_sous_lot else '' }}">
                <strong class="mr16">Sous-total<t t-if="section_fermee and section_fermee.name"> · <t t-out="section_fermee.name"/></t></strong>
                <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
            </td>
        </xpath>
        <xpath expr="//tr[hasclass('is-subtotal')]" position="after">
            <t t-if="lot_a_sous_lots and lot_courant and (line_last or (lines_to_report[line_index+1].display_type == 'line_section' and not lines_to_report[line_index+1].cultiveau_sous_lot))">
                <t t-set="lot_a_sous_lots" t-value="False"/>
                <tr class="is-subtotal text-end">
                    <td colspan="99" style="border-top: 1px solid #888;">
                        <strong class="mr16">Total · <t t-out="lot_courant.name"/></strong>
                        <span t-out="lot_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>
        <!-- Les CGV en dernière page. -->
        <xpath expr="//span[@name='order_note']/.." position="after">
            <t t-if="doc.company_id.cultiveau_cgv and not is_html_empty(doc.company_id.cultiveau_cgv) and not env.context.get('proforma')">
                <div style="page-break-before: always;"/>
                <div style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">Conditions générales de vente</div>
                <div style="font-size: 9px; line-height: 1.3; column-count: 2; column-gap: 18px;" name="cgv_cultiveau">
                    <t t-out="doc.company_id.cultiveau_cgv"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
