<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_reunion" model="ir.ui.view">
        <field name="name">res.config.settings.form.cultiveau.reunion</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="cultiveau_base.res_config_settings_view_form_cultiveau"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='cultiveau_outils']" position="before">
                <block title="Réunions et agendas" name="cultiveau_reunion">
                    <setting string="La salle de réunion" help="Les réunions planifiées depuis la map, une fiche ou Mathis : créneaux proposés dans ces heures, du lundi au vendredi.">
                        <div class="row mt8"><label for="cultiveau_salle_nom" class="col-lg-4 o_light_label"/><field name="cultiveau_salle_nom"/></div>
                        <div class="row mt8"><label for="cultiveau_heures_reunion" class="col-lg-4 o_light_label"/><field name="cultiveau_heures_reunion"/></div>
                        <div class="row mt8"><label for="cultiveau_visio_defaut" class="col-lg-4 o_light_label"/><field name="cultiveau_visio_defaut"/></div>
                    </setting>
                    <setting string="Google Agenda et Google Meet" help="Fournis une fois pour tout le réseau (secrets du serveur) : rien à saisir, chacun connecte son agenda d'un clic depuis la salle de réunion de la map. Sinon : un identifiant OAuth « Application Web » de la console Google Cloud, avec cette adresse de retour.">
                        <div class="row mt8"><label for="cultiveau_url_retour_google" class="col-lg-4 o_light_label"/><field name="cultiveau_url_retour_google" readonly="1"/></div>
                        <div class="row mt8"><label for="cal_client_id" string="Identifiant client" class="col-lg-4 o_light_label"/><field name="cal_client_id"/></div>
                        <div class="row mt8"><label for="cal_client_secret" string="Secret client" class="col-lg-4 o_light_label"/><field name="cal_client_secret" password="True"/></div>
                    </setting>
                    <setting string="Outlook et Teams" help="Fournis une fois pour tout le réseau (secrets du serveur) : rien à saisir. Sinon : une application du portail Microsoft Entra (Calendars.ReadWrite, OnlineMeetings.ReadWrite), avec cette adresse de retour.">
                        <div class="row mt8"><label for="cultiveau_url_retour_microsoft" class="col-lg-4 o_light_label"/><field name="cultiveau_url_retour_microsoft" readonly="1"/></div>
                        <div class="row mt8"><label for="cal_microsoft_client_id" string="Identifiant client" class="col-lg-4 o_light_label"/><field name="cal_microsoft_client_id"/></div>
                        <div class="row mt8"><label for="cal_microsoft_client_secret" string="Secret client" class="col-lg-4 o_light_label"/><field name="cal_microsoft_client_secret" password="True"/></div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
