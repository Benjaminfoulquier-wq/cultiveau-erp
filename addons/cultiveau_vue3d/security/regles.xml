        <field name="name">Plan : sa société</field>
        <field name="model_id" ref="model_cultiveau_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_pointage_societe" model="ir.rule">
        <field name="name">Pointage : sa société</field>
        <field name="model_id" ref="model_cultiveau_pointage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_evenement_societe" model="ir.rule">
        <field name="name">Événement : sa société</field>
        <field name="model_id" ref="model_cultiveau_evenement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
