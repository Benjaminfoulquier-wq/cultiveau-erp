<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cultiveau_vue3d.Vue">
        <div class="o_cultiveau_vue3d d-flex flex-column h-100">
            <div class="o_cultiveau_vue3d_entete d-flex align-items-center gap-3 px-3 py-2 flex-wrap">
                <h2 class="m-0" t-esc="state.donnees ? state.donnees.societe.nom : ''"/>
                <div class="o_cv_recherche position-relative">
                    <i class="fa fa-search"/>
                    <input type="text" class="form-control form-control-sm" placeholder="Où aller ? facture, fiche technique, pompes, chantier…"
                           t-model="state.recherche" t-on-input="chercher" t-on-keydown="onToucheRecherche"/>
                    <div class="o_cv_resultats" t-if="state.resultats.length">
                        <button t-foreach="state.resultats" t-as="r" t-key="r_index" class="o_cv_resultat" t-on-click="() => this.choisir(r)">
                            <t t-if="r.zone"><i t-att-class="'fa ' + r.zone.icone"/> <b t-esc="r.zone.nom"/> <small>zone</small></t>
                            <t t-else=""><i t-att-class="'fa ' + r.poste.icone"/> <b t-esc="r.poste.titre"/> <small t-if="r.action">→ <t t-esc="r.action.libelle"/></small></t>
                        </button>
                    </div>
                </div>
                <div class="ms-auto d-flex gap-2 flex-wrap align-items-center" t-if="state.donnees">
                    <button class="btn btn-sm btn-light" t-on-click="() => this.ouvrirListe('sale.order', [['state', 'in', ['draft', 'sent']]], 'Devis en cours')">
                        <b t-esc="state.donnees.compteurs.devis"/> devis — <b t-esc="state.donnees.compteurs.devis_montant.toLocaleString('fr-FR')"/> €</button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.ouvrirListe('project.task', [['cultiveau_intervention', '=', true], ['state', 'not in', ['1_done', '1_canceled']]], 'Interventions à faire')">
                        <b t-esc="state.donnees.compteurs.interventions"/> interventions</button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.ouvrirListe('account.move', [['move_type', '=', 'out_invoice'], ['state', '=', 'posted'], ['payment_state', 'in', ['not_paid', 'partial']]], 'Factures à encaisser')">
                        <b t-esc="state.donnees.compteurs.factures_montant.toLocaleString('fr-FR')"/> € à encaisser</button>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-primary dropdown-toggle" data-bs-toggle="dropdown"><i class="fa fa-plus me-1"/>Créer</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li t-if="state.donnees.compteurs.comptoir"><a class="dropdown-item" href="#" t-on-click.prevent="() => this.ouvrirAction('cultiveau_comptoir.action_comptoir')">Une vente au comptoir</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.lancer({cle: 'facture_nouvelle'}, null)">Une facture</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('sale.order', {})">Un devis</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('res.partner', {default_cultiveau_type: 'agriculteur', default_is_company: false})">Un agriculteur</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('crm.lead', {default_type: 'opportunity'})">Une demande (appel, visite)</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('cultiveau.installation', {default_etat: 'etude'})">Une étude d'installation</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('project.task', {default_cultiveau_nature: 'depannage'})">Un dépannage</a></li>
                            <li t-if="state.donnees.chantiers.chantiers"><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('cultiveau.chantier', {})">Un chantier</a></li>
                            <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.creer('purchase.order', {})">Une commande fournisseur</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="o_cultiveau_vue3d_zones d-flex gap-1 px-3 py-1 flex-wrap align-items-center">
                <button class="btn btn-sm" t-att-class="state.zone ? 'btn-light' : 'btn-dark'" t-on-click="toutVoir"><i class="fa fa-globe me-1"/>Tout le site</button>
                <button t-foreach="zones" t-as="z" t-key="z.cle" class="btn btn-sm" t-att-class="state.zone === z.cle ? 'btn-dark' : 'btn-light'" t-on-click="() => this.allerZone(z)">
                    <i t-att-class="'fa me-1 ' + z.icone"/><t t-esc="z.nom"/>
                </button>
            </div>
            <div class="o_cultiveau_vue3d_scene flex-grow-1 position-relative" t-if="!state.sans3d">
                <div t-ref="hote" class="o_cv3_hote"/>
                <div t-ref="calque" class="o_cv3_calque loin"/>
                <div class="o_cv3_chargement" t-if="!state.pret"><i class="fa fa-cube fa-spin"/> Construction du site…</div>

                <div class="o_cv_commandes">
                    <button class="btn btn-light btn-sm" title="Rapprocher (+)" t-on-click="() => this.zoomer(0.75)"><i class="fa fa-plus"/></button>
                    <button class="btn btn-light btn-sm" title="Éloigner (−)" t-on-click="() => this.zoomer(1.33)"><i class="fa fa-minus"/></button>
                    <button class="btn btn-light btn-sm" title="Tourner à gauche (Q)" t-on-click="() => this.tourner(-1)"><i class="fa fa-rotate-left"/></button>
                    <button class="btn btn-light btn-sm" title="Tourner à droite (E)" t-on-click="() => this.tourner(1)"><i class="fa fa-rotate-right"/></button>
                    <button class="btn btn-light btn-sm" title="Tout le site (0)" t-on-click="toutVoir"><i class="fa fa-arrows-alt"/></button>
                </div>

                <div class="o_cv_carte" t-ref="carte" t-if="state.carte" t-on-click.stop="" t-on-pointerdown.stop="">
                    <div class="d-flex align-items-start gap-2">
                        <span class="o_cv_carte_icone" t-att-style="'background:' + state.carte.couleur"><i t-att-class="'fa ' + state.carte.icone"/></span>
                        <div class="flex-grow-1">
                            <div class="o_cv_carte_titre" t-esc="state.carte.titre"/>
                            <div class="o_cv_carte_texte" t-esc="state.carte.texte"/>
                        </div>
                        <button class="btn btn-link btn-sm p-0 text-muted" t-on-click="() => state.carte = null"><i class="fa fa-times"/></button>
                    </div>
                    <div class="o_cv_carte_stats" t-if="state.carte.stats.length">
                        <span t-foreach="state.carte.stats" t-as="st" t-key="st_index" t-esc="st"/>
                    </div>
                    <div class="d-grid gap-1 mt-2">
                        <button t-foreach="state.carte.actions" t-as="a" t-key="a.cle" class="btn btn-sm text-start d-flex align-items-center"
                                t-att-class="a.principal ? 'btn-primary' : 'btn-light'" t-on-click="() => this.lancer(a)">
                            <i t-att-class="'fa fa-fw me-2 ' + (a.icone || (a.principal ? 'fa-arrow-right' : 'fa-angle-right'))"/>
                            <span class="flex-grow-1" t-esc="a.libelle"/>
                            <span class="badge rounded-pill" t-att-class="a.principal ? 'text-bg-light' : 'text-bg-secondary'" t-if="a.badge" t-esc="a.badge.toLocaleString('fr-FR')"/>
                        </button>
                    </div>
                </div>

                <div class="o_cv3_bulle" t-ref="bulle" t-att-class="state.survol and !state.carte ? 'visible' : ''" t-esc="state.survol or ''"/>
                <div class="o_cultiveau_vue3d_legende">
                    <span class="aide"><i class="fa fa-mouse-pointer"/> clic : ouvrir · molette : zoomer · glisser : se déplacer · Q / E : tourner</span>
                    <span><i style="background:#e2605b"/> urgent</span>
                    <span><i style="background:#f6a852"/> aujourd'hui / chantier</span>
                    <span><i style="background:#0b9bb8"/> cette semaine / envoyé</span>
                    <span><i style="background:#76b357"/> en service</span>
                    <span><i style="background:#efbf4a"/> à l'étude</span>
                </div>
            </div>
            <div class="o_cv3_sans3d flex-grow-1 overflow-auto p-3" t-else="">
                <div class="text-muted mb-3">La 3D n'est pas disponible sur ce navigateur : voici les mêmes portes, zone par zone.</div>
                <div t-foreach="postesParZone" t-as="z" t-key="z.cle" class="mb-4">
                    <h4><i t-att-class="'fa me-2 ' + z.icone"/><t t-esc="z.nom"/></h4>
                    <div class="d-flex flex-wrap gap-3">
                        <div t-foreach="z.postes" t-as="p" t-key="p.cle" class="o_cv_carte position-static" style="width: 300px">
                            <div class="o_cv_carte_titre" t-esc="p.titre"/>
                            <div class="o_cv_carte_texte" t-esc="p.texte"/>
                            <div class="d-grid gap-1 mt-2">
                                <button t-foreach="p.actions" t-as="a" t-key="a.cle" class="btn btn-sm text-start" t-att-class="a.principal ? 'btn-primary' : 'btn-light'"
                                        t-on-click="() => this.lancer(a, p)"><t t-esc="a.libelle"/></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
