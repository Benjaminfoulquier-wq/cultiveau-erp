<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_regle_societe" model="ir.rule">
        <field name="name">Automatisations : la société</field>
        <field name="model_id" ref="model_cultiveau_regle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_trace_societe" model="ir.rule">
        <field name="name">Traces d'automatisation : la société</field>
        <field name="model_id" ref="model_cultiveau_regle_trace"/>
        <field name="domain_force">[('regle_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
