<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_rapport_lundi" model="ir.config_parameter">
            <field name="key">cultiveau.rapport_lundi</field>
            <field name="value">True</field>
        </record>
        <record id="cron_rapport_lundi" model="ir.cron">
            <field name="name">Cultiveau : rapport du lundi</field>
            <field name="model_id" ref="model_cultiveau_rapport"/>
            <field name="state">code</field>
            <field name="code">model._cron_lundi()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(weekday=0, days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_regles" model="ir.cron">
            <field name="name">Cultiveau : automatisations</field>
            <field name="model_id" ref="model_cultiveau_regle"/>
            <field name="state">code</field>
            <field name="code">model._cron()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="mail_relance_devis" model="mail.template">
            <field name="name">Cultiveau : relance d'un devis</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre devis {{ object.name }} — {{ object.company_id.name }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
<div>
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Nous vous avons adressé le devis <b t-out="object.name or ''"/> (<t t-out="format_amount(object.amount_total, object.currency_id) or ''"/> TTC). Avez-vous pu le consulter ?</p>
    <p>Nous restons à votre disposition pour en parler, l'ajuster ou passer vous voir. Il suffit de répondre à ce message ou de nous appeler.</p>
    <p>Bien cordialement,<br/><t t-out="object.user_id.name or object.company_id.name or ''"/><br/><t t-out="object.company_id.name or ''"/></p>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="mail_merci_paiement" model="mail.template">
            <field name="name">Cultiveau : merci pour le règlement</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Merci pour votre règlement — {{ object.company_id.name }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
<div>
    <p>Bonjour <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Nous avons bien reçu le règlement de la facture <b t-out="object.name or ''"/>. Merci pour votre confiance.</p>
    <p>Pour toute question sur votre installation, nous sommes joignables par retour de message ou par téléphone.</p>
    <p>Bien cordialement,<br/><t t-out="object.company_id.name or ''"/></p>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>

    <function model="cultiveau.regle" name="preparer"/>
</odoo>
