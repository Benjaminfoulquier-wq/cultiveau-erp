<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_presentation" model="ir.ui.view">
        <field name="name">res.config.settings.form.cultiveau.presentation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="cultiveau_documents.res_config_settings_view_form_documents"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='cultiveau_documents']" position="inside">
                <setting string="Niveau de détail" help="Ce que le client voit : chaque article, un montant par lot, un forfait, ou matériel et main-d'œuvre séparés. Modifiable sur chaque devis et chaque facture ; une ligne peut aussi être masquée.">
                    <div class="row mt8"><label for="cultiveau_detail_devis" class="col-lg-4 o_light_label"/><field name="cultiveau_detail_devis"/></div>
                    <div class="row mt8"><label for="cultiveau_detail_facture" class="col-lg-4 o_light_label"/><field name="cultiveau_detail_facture"/></div>
                </setting>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_presentation" model="ir.ui.view">
        <field name="name">sale.order.form.cultiveau.presentation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="cultiveau_detail"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="cultiveau_masque" optional="hide" string="Masquée"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_presentation" model="ir.ui.view">
        <field name="name">account.move.form.cultiveau.presentation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                <field name="cultiveau_detail" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="cultiveau_masque" optional="hide" string="Masquée"/>
            </xpath>
        </field>
    </record>
</odoo>
