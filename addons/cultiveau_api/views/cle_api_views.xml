<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cle_api_form" model="ir.ui.view">
        <field name="name">cultiveau.cle.api.form</field>
        <field name="model">cultiveau.cle.api</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cle_copiee" type="object" string="J'ai copié la clé" class="btn-primary" invisible="not cle_a_copier"/>
                    <button name="action_regenerer" type="object" string="Nouvelle clé" invisible="cle_a_copier"
                            confirm="L'ancienne clé cessera aussitôt de fonctionner. Continuer ?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Désactivée" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Site cultiveau.fr, Claude, appli des techniciens…"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="not cle_a_copier">
                        <strong>Copiez la clé maintenant :</strong> elle ne sera plus montrée. L'ERP n'en garde qu'une empreinte.
                    </div>
                    <group invisible="not cle_a_copier">
                        <field name="cle_a_copier" widget="CopyClipboardChar"/>
                        <field name="adresse_mcp" widget="CopyClipboardChar" invisible="usage != 'claude'"/>
                    </group>
                    <group>
                        <group>
                            <field name="usage"/>
                            <field name="droits" widget="radio"/>
                            <field name="company_ids" widget="many2many_tags" placeholder="Tout le réseau"/>
                            <field name="expire_le"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="prefixe"/>
                            <field name="adresse_api" widget="CopyClipboardChar"/>
                            <field name="derniere_utilisation"/>
                            <field name="nb_appels"/>
                        </group>
                    </group>
                    <group string="Comment s'en servir">
                        <div colspan="2" class="text-muted">
                            <p><b>Site, appli, outil du réseau :</b> chaque requête porte l'en-tête <code>Authorization: Bearer &lt;la clé&gt;</code>.
                               Ressources : clients, interventions, chantiers, installations, registre, devis, commandes, factures, opportunités,
                               articles, fiches, adhérents ; <code>/resume</code> pour le tableau de bord. La description complète est à
                               <code>/cultiveau/api/v1/openapi.json</code>.</p>
                            <p><b>Claude :</b> dans Claude, Réglages → Connecteurs → Ajouter un connecteur personnalisé, collez l'adresse du connecteur
                               (elle contient la clé). Claude peut alors lire l'ERP, et y déposer clients, interventions et opportunités si la clé est en écriture.</p>
                        </div>
                    </group>
                    <field name="notes" placeholder="Qui l'utilise, pour quoi…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cle_api_list" model="ir.ui.view">
        <field name="name">cultiveau.cle.api.list</field>
        <field name="model">cultiveau.cle.api</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="name"/>
                <field name="usage"/>
                <field name="droits"/>
                <field name="company_ids" widget="many2many_tags"/>
                <field name="prefixe"/>
                <field name="derniere_utilisation"/>
                <field name="nb_appels"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_cles_api" model="ir.actions.act_window">
        <field name="name">Clés d'API</field>
        <field name="res_model">cultiveau.cle.api</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune clé d'API</p>
            <p>Une clé par outil : le site cultiveau.fr, l'appli, Claude. Chacun lit l'ERP (et y écrit, si vous le permettez) avec sa propre clé,
               que vous pouvez couper à tout moment.</p>
        </field>
    </record>

    <menuitem id="menu_cles_api" name="Clés d'API" parent="cultiveau_base.menu_cultiveau_reglages" action="action_cles_api" sequence="120"/>
</odoo>
