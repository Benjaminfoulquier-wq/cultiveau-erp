<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_armoire" model="ir.sequence">
            <field name="name">Dossier de câblage</field>
            <field name="code">cultiveau.armoire</field>
            <field name="prefix">ARM-</field>
            <field name="padding">4</field>
        </record>
        <record id="paperformat_a3_paysage" model="report.paperformat">
            <field name="name">A3 paysage (folios)</field>
            <field name="format">A3</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">6</field>
            <field name="margin_bottom">6</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>
    </data>
    <record id="action_serveur_cablage" model="ir.actions.server">
        <field name="name">Câblage de l'armoire</field>
        <field name="model_id" ref="cultiveau_installation.model_cultiveau_installation"/>
        <field name="binding_model_id" ref="cultiveau_installation.model_cultiveau_installation"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_cablage()</field>
    </record>
</odoo>
