<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tableau_form" model="ir.ui.view">
        <field name="name">cultiveau.tableau.form</field>
        <field name="model">cultiveau.tableau</field>
        <field name="arch" type="xml">
            <form create="0" edit="1">
                <sheet>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <h2 class="mb-0">Tableau de bord</h2>
                        <field name="company_id" groups="base.group_multi_company" class="oe_inline"/>
                        <label for="reseau" string="Vue réseau" groups="cultiveau_base.group_equipe"/><field name="reseau" groups="cultiveau_base.group_equipe"/>
                    </div>
                    <field name="html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tableau" model="ir.actions.act_window">
        <field name="name">Tableau de bord</field>
        <field name="res_model">cultiveau.tableau</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
