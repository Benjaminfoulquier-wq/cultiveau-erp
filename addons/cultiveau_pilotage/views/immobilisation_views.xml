<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_immo_list" model="ir.ui.view">
        <field name="name">cultiveau.immobilisation.list</field>
        <field name="model">cultiveau.immobilisation</field>
        <field name="arch" type="xml">
            <list decoration-muted="etat in ('amortie', 'cedee')">
                <field name="name"/><field name="compte_id"/><field name="date_debut"/><field name="valeur"/><field name="duree_mois"/><field name="amorti"/><field name="valeur_nette"/>
                <field name="etat" widget="badge" decoration-info="etat == 'en_cours'" decoration-success="etat == 'amortie'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_immo_form" model="ir.ui.view">
        <field name="name">cultiveau.immobilisation.form</field>
        <field name="model">cultiveau.immobilisation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculer_plan" type="object" string="Calculer le plan d'amortissement" class="btn-primary" invisible="etat not in ('brouillon', 'en_cours')"/>
                    <button name="action_passer_dotations" type="object" string="Passer les dotations échues" invisible="etat != 'en_cours'"/>
                    <button name="action_sortir" type="object" string="Sortir du patrimoine" invisible="etat not in ('en_cours', 'amortie')" confirm="L'immobilisation sort du bilan (vente, casse, mise au rebut) : l'écriture de sortie est passée. Continuer ?"/>
                    <field name="etat" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name" placeholder="Camion benne, mini-pelle, enrouleur de démonstration…"/></h1>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/><field name="currency_id" invisible="1"/>
                            <field name="compte_id"/><field name="compte_amortissement_id"/><field name="compte_dotation_id"/><field name="partner_id"/>
                        </group>
                        <group>
                            <field name="valeur"/><field name="valeur_residuelle"/><field name="date_debut"/><field name="duree_mois"/><field name="amorti"/><field name="valeur_nette"/>
                            <field name="facture_line_id" invisible="not facture_line_id"/>
                        </group>
                    </group>
                    <field name="ligne_ids" readonly="1">
                        <list><field name="date"/><field name="montant"/><field name="cumul"/><field name="valeur_nette"/><field name="move_id"/></list>
                    </field>
                    <group><field name="note"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_immos" model="ir.actions.act_window">
        <field name="name">Immobilisations</field>
        <field name="res_model">cultiveau.immobilisation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Aucune immobilisation</p><p>Le camion, la mini-pelle, le matériel de démonstration : le plan d'amortissement se calcule, les dotations passent chaque mois. Depuis une facture d'achat sur un compte 2…, le bouton « Immobiliser » fait tout.</p></field>
    </record>
    <record id="view_move_form_immo" model="ir.ui.view">
        <field name="name">account.move.form.cultiveau.immo</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="cultiveau_a_immobiliser" invisible="1"/>
                <button name="action_cultiveau_immobiliser" type="object" string="Immobiliser" invisible="not cultiveau_a_immobiliser" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
