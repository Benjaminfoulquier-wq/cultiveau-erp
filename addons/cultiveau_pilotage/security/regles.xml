<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_cloture_societe" model="ir.rule">
        <field name="name">Clôtures : par société</field>
        <field name="model_id" ref="model_cultiveau_cloture"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_immo_societe" model="ir.rule">
        <field name="name">Immobilisations : par société</field>
        <field name="model_id" ref="model_cultiveau_immobilisation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
