<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_feuille_veille" model="ir.cron">
            <field name="name">Cultiveau : feuille de route de demain aux salariés</field>
            <field name="model_id" ref="model_cultiveau_feuille_route"/>
            <field name="state">code</field>
            <field name="code">model._cron_veille()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=16, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
