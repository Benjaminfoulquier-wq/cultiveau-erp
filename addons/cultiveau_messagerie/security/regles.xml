<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_boite_societe" model="ir.rule">
        <field name="name">Boîtes mail : la société</field>
        <field name="model_id" ref="model_cultiveau_boite"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_courriel_societe" model="ir.rule">
        <field name="name">Courriels : la société</field>
        <field name="model_id" ref="model_cultiveau_courriel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- une boîte personnelle n'est lue que par son responsable (et le gérant) -->
    <record id="regle_courriel_personnel" model="ir.rule">
        <field name="name">Courriels : boîtes partagées et sa propre boîte</field>
        <field name="model_id" ref="model_cultiveau_courriel"/>
        <field name="domain_force">['|', '|', ('boite_id', '=', False), ('boite_id.partagee', '=', True), ('boite_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="regle_courriel_gerant" model="ir.rule">
        <field name="name">Courriels : le gérant voit tout</field>
        <field name="model_id" ref="model_cultiveau_courriel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
</odoo>
