<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_relever" model="ir.cron">
            <field name="name">Cultiveau : relève des boîtes mail</field>
            <field name="model_id" ref="model_cultiveau_boite"/>
            <field name="state">code</field>
            <field name="code">model._cron_relever()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_sans_reponse" model="ir.cron">
            <field name="name">Cultiveau : courriels sans réponse</field>
            <field name="model_id" ref="model_cultiveau_courriel"/>
            <field name="state">code</field>
            <field name="code">model._cron_sans_reponse()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
