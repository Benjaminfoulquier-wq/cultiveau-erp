<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_synchro_site" model="ir.cron">
        <field name="name">Cultiveau : synchroniser l'espace adhérent de cultiveau.fr</field>
        <field name="model_id" ref="model_cultiveau_site_connexion"/>
        <field name="state">code</field>
        <field name="code">model._cron_synchroniser()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_chantiers_vers_site" model="ir.cron">
        <field name="name">Cultiveau : chantiers de l'ERP vers l'appli Mon Chantier</field>
        <field name="model_id" ref="model_cultiveau_chantier"/>
        <field name="state">code</field>
        <field name="code">model._cron_envoyer_vers_site()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_articles_vers_site" model="ir.cron">
        <field name="name">Cultiveau : envoyer les articles de l'ERP dans la base de cultiveau.fr</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_envoyer_vers_site()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
