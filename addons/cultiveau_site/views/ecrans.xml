<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Les écrans de cultiveau.fr et de la logistique, affichés tels quels dans l'ERP : une évolution du site s'y voit tout de suite. -->
    <menuitem id="menu_espace" name="Mon Espace" parent="cultiveau_base.menu_cultiveau_root" sequence="2"/>
    <record id="action_ecran_espace" model="ir.actions.client">
        <field name="name">Mon Espace (accueil)</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/espace"}</field>
    </record>
    <menuitem id="menu_ecran_espace" name="Mon Espace (accueil)" parent="menu_espace" action="action_ecran_espace" sequence="1"/>
    <record id="action_ecran_interventions" model="ir.actions.client">
        <field name="name">Mes Interventions</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/espace?view=mes_interventions"}</field>
    </record>
    <menuitem id="menu_ecran_interventions" name="Mes Interventions" parent="menu_espace" action="action_ecran_interventions" sequence="2"/>
    <record id="action_ecran_chantier" model="ir.actions.client">
        <field name="name">Mon Chantier</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/chantier"}</field>
    </record>
    <menuitem id="menu_ecran_chantier" name="Mon Chantier" parent="menu_espace" action="action_ecran_chantier" sequence="3"/>
    <record id="action_ecran_bons" model="ir.actions.client">
        <field name="name">Bons d'intervention</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/sav/historique"}</field>
    </record>
    <menuitem id="menu_ecran_bons" name="Bons d'intervention" parent="menu_espace" action="action_ecran_bons" sequence="4"/>
    <record id="action_ecran_equipe" model="ir.actions.client">
        <field name="name">Mon Équipe</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/mon-equipe"}</field>
    </record>
    <menuitem id="menu_ecran_equipe" name="Mon Équipe" parent="menu_espace" action="action_ecran_equipe" sequence="5"/>
    <record id="action_ecran_inventaire" model="ir.actions.client">
        <field name="name">Mon Inventaire</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/mon-inventaire"}</field>
    </record>
    <menuitem id="menu_ecran_inventaire" name="Mon Inventaire" parent="menu_espace" action="action_ecran_inventaire" sequence="6"/>
    <record id="action_ecran_dict" model="ir.actions.client">
        <field name="name">Mes DICT</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/mes-dict"}</field>
    </record>
    <menuitem id="menu_ecran_dict" name="Mes DICT" parent="menu_espace" action="action_ecran_dict" sequence="7"/>
    <record id="action_ecran_ao" model="ir.actions.client">
        <field name="name">Appels d'offres</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "/adherent/appels-offres"}</field>
    </record>
    <menuitem id="menu_ecran_ao" name="Appels d'offres" parent="menu_espace" action="action_ecran_ao" sequence="8"/>
    <record id="action_ecran_logistique" model="ir.actions.client">
        <field name="name">Logistique</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "logistique"}</field>
    </record>
    <menuitem id="menu_logistique" name="Logistique" parent="cultiveau_base.menu_cultiveau_root" action="action_ecran_logistique" sequence="3"/>

    <!-- L'assistant téléphonique, réglé et lu depuis l'ERP (08/11/2026) : qui fait quoi, textes et horaires, appels à lire et à écouter,
         demandes à suivre. Les écrans sont ceux d'assistant.cultiveau.fr, ouverts sur l'adhérent de la personne connectée (/moi/…). -->
    <menuitem id="menu_assistant" name="Assistant téléphonique" parent="cultiveau_base.menu_cultiveau_root" sequence="24"/>
    <record id="action_assistant_standard" model="ir.actions.client">
        <field name="name">Mon standard</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "assistant:/moi/"}</field>
    </record>
    <menuitem id="menu_assistant_standard" name="Mon standard" parent="menu_assistant" action="action_assistant_standard" sequence="1"/>
    <record id="action_assistant_reglages" model="ir.actions.client">
        <field name="name">Qui fait quoi, textes, horaires</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "assistant:/moi/reglages/"}</field>
    </record>
    <menuitem id="menu_assistant_reglages" name="Qui fait quoi, textes, horaires" parent="menu_assistant" action="action_assistant_reglages" sequence="2"/>
    <record id="action_assistant_appels" model="ir.actions.client">
        <field name="name">Appels : lire et écouter</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "assistant:/moi/crm/"}</field>
    </record>
    <menuitem id="menu_assistant_appels" name="Appels : lire et écouter" parent="menu_assistant" action="action_assistant_appels" sequence="3"/>
    <record id="action_assistant_demandes" model="ir.actions.client">
        <field name="name">Demandes à suivre</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "assistant:/moi/demandes/"}</field>
    </record>
    <menuitem id="menu_assistant_demandes" name="Demandes à suivre" parent="menu_assistant" action="action_assistant_demandes" sequence="4"/>
    <record id="action_assistant_agenda" model="ir.actions.client">
        <field name="name">Agenda de l'assistant</field>
        <field name="tag">cultiveau_site.ecran</field>
        <field name="context">{"vers": "assistant:/moi/agenda/"}</field>
    </record>
    <menuitem id="menu_assistant_agenda" name="Agenda de l'assistant" parent="menu_assistant" action="action_assistant_agenda" sequence="5"/>
    <menuitem id="menu_assistant_appels_erp" name="Appels rangés dans l'ERP" parent="menu_assistant" action="cultiveau_connecteurs.action_appels" sequence="6" groups="base.group_user"/>
</odoo>
