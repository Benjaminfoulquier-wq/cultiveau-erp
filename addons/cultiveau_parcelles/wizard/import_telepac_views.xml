<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_telepac_form" model="ir.ui.view">
        <field name="name">cultiveau.import.telepac.form</field>
        <field name="model">cultiveau.import.telepac</field>
        <field name="arch" type="xml">
            <form>
                <p>Le fichier que le client télécharge dans Telepac pour sa déclaration de l'année : l'export <b>XML</b> de la déclaration
                   (îlots et parcelles), ou le <b>ZIP</b> des parcelles (shapefile). Les parcelles, leur contour et leur culture arrivent sur sa fiche ;
                   ses cultures et leurs besoins en eau se mettent à jour.</p>
                <group>
                    <field name="partner_id"/>
                    <field name="fichier" filename="nom_fichier"/>
                    <field name="nom_fichier" invisible="1"/>
                    <field name="campagne"/>
                </group>
                <footer>
                    <button name="action_importer" type="object" string="Importer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
