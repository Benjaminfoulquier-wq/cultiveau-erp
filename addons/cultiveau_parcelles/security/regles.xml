<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_parcelle_societe" model="ir.rule">
        <field name="name">Parcelles : celles des clients de mes adhérents</field>
        <field name="model_id" ref="model_cultiveau_parcelle"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_alerte_societe" model="ir.rule">
        <field name="name">Alertes satellite : celles des clients de mes adhérents</field>
        <field name="model_id" ref="model_cultiveau_parcelle_alerte"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
