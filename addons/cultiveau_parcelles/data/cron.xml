<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_satellite" model="ir.cron">
        <field name="name">Cultiveau : images Sentinel-2 des parcelles (NDVI, NDWI) et alertes</field>
        <field name="model_id" ref="model_cultiveau_parcelle"/>
        <field name="state">code</field>
        <field name="code">model._cron_satellite()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_irrigation" model="ir.cron">
        <field name="name">Cultiveau : conseil d'irrigation (météo et bilan des parcelles)</field>
        <field name="model_id" ref="model_cultiveau_parcelle"/>
        <field name="state">code</field>
        <field name="code">model._cron_irrigation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_meteo_menage" model="ir.cron">
        <field name="name">Cultiveau : ménage de la météo (plus d'un an)</field>
        <field name="model_id" ref="model_cultiveau_meteo_jour"/>
        <field name="state">code</field>
        <field name="code">model._cron_menage()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
    </record>
</odoo>
