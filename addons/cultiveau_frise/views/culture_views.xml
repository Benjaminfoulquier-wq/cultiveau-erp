<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_culture_list" model="ir.ui.view">
        <field name="name">cultiveau.culture.list</field>
        <field name="model">cultiveau.culture</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="categorie"/>
                <field name="couleur" widget="color"/>
                <field name="kc_ini" optional="show"/>
                <field name="kc_mi" optional="show"/>
                <field name="kc_fin" optional="show"/>
                <field name="duree_cycle" optional="hide"/>
                <field name="racines_max" optional="hide"/>
                <field name="cours_tendance"/>
                <field name="nb_clients"/>
            </list>
        </field>
    </record>

    <record id="view_culture_form" model="ir.ui.view">
        <field name="name">cultiveau.culture.form</field>
        <field name="model">cultiveau.culture</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Vigne, Pommier, Maïs…"/></h1></div>
                    <group>
                        <group>
                            <field name="categorie"/>
                            <field name="couleur" widget="color"/>
                            <field name="actif"/>
                        </group>
                        <group string="Cours agricoles (le contexte économique)">
                            <field name="cours_tendance"/>
                            <field name="cours_note" placeholder="Vin IGP Gard : −8 % sur un an"/>
                            <field name="cours_date"/>
                            <field name="cours_ton"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stades et besoins en eau" name="stades">
                            <p class="text-muted">Pour chaque stade : les besoins en eau, et la <b>posture</b> que l'agriculteur attend de nous (écoute l'hiver, support au printemps, discrétion l'été et pendant les périodes critiques, proposition après récolte). Les stades critiques (semis, floraison, récolte, vendanges) sont détectés d'après leur nom : on ne dérange pas.</p>
                            <field name="stade_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="departement"/>
                                    <field name="name"/>
                                    <field name="mois_debut"/>
                                    <field name="mois_fin"/>
                                    <field name="kc_min"/>
                                    <field name="kc_max"/>
                                    <field name="besoin_min"/>
                                    <field name="besoin_max"/>
                                    <field name="etp_min"/>
                                    <field name="etp_max"/>
                                    <field name="irrigation"/>
                                    <field name="posture"/>
                                    <field name="critique"/>
                                </list>
                            </field>
                        </page>
                        <page string="Coefficients culturaux (Kc)" name="kc">
                            <p class="text-muted">Le besoin en eau de la culture = ETo (évapotranspiration de référence, Météo-France) × Kc. Valeurs de référence FAO-56 pour un climat sub-humide ; les durées de phase sont indicatives pour la France.</p>
                            <field name="courbe_kc" nolabel="1" invisible="not courbe_kc"/>
                            <group>
                                <group string="Kc">
                                    <field name="kc_ini"/>
                                    <field name="kc_mi"/>
                                    <field name="kc_fin"/>
                                    <field name="source_kc"/>
                                </group>
                                <group string="Durée des phases">
                                    <field name="duree_ini"/>
                                    <field name="duree_dev"/>
                                    <field name="duree_mi"/>
                                    <field name="duree_fin"/>
                                    <field name="duree_cycle"/>
                                </group>
                                <group string="Plante et sol">
                                    <field name="hauteur_max"/>
                                    <field name="racines_min"/>
                                    <field name="racines_max"/>
                                    <field name="p_tarissement"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fenêtres commerciales" name="fenetres">
                            <p class="text-muted">Quand l'agriculteur a le temps de parler projet, et quand il achète. Par département ; vide = partout.</p>
                            <field name="fenetre_ids">
                                <list editable="bottom">
                                    <field name="departement"/>
                                    <field name="genre"/>
                                    <field name="mois_debut"/>
                                    <field name="mois_fin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_culture_search" model="ir.ui.view">
        <field name="name">cultiveau.culture.search</field>
        <field name="model">cultiveau.culture</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <group expand="0" string="Regrouper par">
                    <filter name="par_famille" string="Famille" context="{'group_by': 'categorie'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cultures" model="ir.actions.act_window">
        <field name="name">Cultures et frise de référence</field>
        <field name="res_model">cultiveau.culture</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_par_famille': 1}</field>
        <field name="help" type="html">
            <p>Toutes les cultures, avec leur frise mois par mois et leurs coefficients culturaux (Kc, FAO-56). La frise « France » vaut
               partout où il n'existe pas de frise locale (comme celle du Gard).</p>
        </field>
    </record>

    <record id="view_culture_client_list" model="ir.ui.view">
        <field name="name">cultiveau.culture.client.list</field>
        <field name="model">cultiveau.culture.client</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="culture_id"/>
                <field name="surface_ha" sum="Total"/>
                <field name="departement"/>
                <field name="projet_mois"/>
                <field name="achat_mois"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_culture_client_form" model="ir.ui.view">
        <field name="name">cultiveau.culture.client.form</field>
        <field name="model">cultiveau.culture.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="La culture">
                            <field name="partner_id"/>
                            <field name="culture_id"/>
                            <field name="surface_ha"/>
                            <field name="departement"/>
                            <field name="date_semis"/>
                            <field name="precocite"/>
                        </group>
                        <group string="Chez le client">
                            <field name="sol_texture"/>
                            <field name="ru_mm_m"/>
                            <field name="systeme"/>
                            <field name="efficience" widget="percentage"/>
                            <field name="heures_jour"/>
                        </group>
                    </group>
                    <div class="alert alert-light border mt-2" role="status" invisible="not analyse">
                        <b>L'analyse : département, culture et client</b>
                        <field name="analyse" nolabel="1"/>
                    </div>
                    <group invisible="not kc_mi_aj">
                        <group string="Kc adaptés">
                            <field name="decalage_jours"/>
                            <field name="kc_ini_aj"/>
                            <field name="kc_mi_aj"/>
                            <field name="kc_fin_aj"/>
                        </group>
                        <group string="Besoin en eau">
                            <field name="eto_pointe"/>
                            <field name="besoin_pointe_mm"/>
                            <field name="dfc_l_s_ha"/>
                            <field name="debit_m3h"/>
                            <field name="besoin_saison_mm"/>
                            <field name="pluie_efficace_mm"/>
                            <field name="irrigation_mm"/>
                            <field name="volume_m3"/>
                            <field name="rfu_mm"/>
                            <field name="tour_eau_j"/>
                        </group>
                    </group>
                    <group>
                        <field name="fenetres"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_culture_client_search" model="ir.ui.view">
        <field name="name">cultiveau.culture.client.search</field>
        <field name="model">cultiveau.culture.client</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="culture_id"/>
                <field name="departement"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_culture" string="Culture" context="{'group_by': 'culture_id'}"/>
                    <filter name="group_departement" string="Département" context="{'group_by': 'departement'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cultures_clients" model="ir.actions.act_window">
        <field name="name">Cultures des agriculteurs</field>
        <field name="res_model">cultiveau.culture.client</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_culture': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Qui cultive quoi, et sur combien d'hectares</p>
            <p>Renseignez les cultures depuis la fiche de chaque agriculteur : la frise et les fenêtres commerciales en découlent.</p>
        </field>
    </record>

    <record id="action_a_contacter" model="ir.actions.act_window">
        <field name="name">À contacter ce mois-ci</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('cultiveau_a_contacter', '=', True)]</field>
        <field name="context">{'default_cultiveau_type': 'agriculteur'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Personne à appeler ce mois-ci</p>
            <p>Les agriculteurs dont une culture ouvre une fenêtre « projet » ou « achat » ce mois-ci apparaissent ici, d'après leur frise culturale.</p>
        </field>
    </record>
</odoo>
