<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="regle_marge_societe" model="ir.rule">
        <field name="name">Marges : par société</field>
        <field name="model_id" ref="model_cultiveau_marge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="regle_groupee_ligne_societe" model="ir.rule">
        <field name="name">Besoins d'une commande groupée : chacun les siens</field>
        <field name="model_id" ref="model_cultiveau_commande_groupee_ligne"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="regle_groupee_ligne_equipe" model="ir.rule">
        <field name="name">Besoins d'une commande groupée : l'équipe voit tout</field>
        <field name="model_id" ref="model_cultiveau_commande_groupee_ligne"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('cultiveau_base.group_equipe'))]"/>
    </record>
</odoo>
