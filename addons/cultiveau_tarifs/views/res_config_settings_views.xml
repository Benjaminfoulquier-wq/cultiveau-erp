<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tarifs" model="ir.ui.view">
        <field name="name">res.config.settings.form.cultiveau.tarifs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="cultiveau_base.res_config_settings_view_form_cultiveau"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='cultiveau_outils']" position="before">
                <block title="Tarifs et marges" name="cultiveau_tarifs">
                    <setting string="Ma marge" help="Sur le prix de vente HT : 30 % veut dire qu'un article acheté 10 € se vend 14,29 €. La liste de prix de la société se construit seule à partir du prix d'achat négocié par le réseau ; les articles sans prix d'achat gardent leur prix catalogue.">
                        <div class="row mt8"><label for="cultiveau_marge_pct" class="col-lg-4 o_light_label"/><field name="cultiveau_marge_pct"/></div>
                        <field name="cultiveau_tarif_vente_id" invisible="1"/>
                        <button name="action_cultiveau_appliquer_marges" type="object" string="Appliquer mes marges" class="btn-link" icon="fa-percent"/>
                        <button name="action_cultiveau_marges_familles" type="object" string="Marges par famille…" class="btn-link" icon="fa-sitemap"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
