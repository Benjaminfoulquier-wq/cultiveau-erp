<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_comportement" model="ir.cron">
        <field name="name">Cultiveau : relire le comportement des clients</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.cultiveau_comportement_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_accompagnement" model="ir.cron">
        <field name="name">Cultiveau : recalculer la liste À accompagner</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model.cultiveau_accompagnement_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
