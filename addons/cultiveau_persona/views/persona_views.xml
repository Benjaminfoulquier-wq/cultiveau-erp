<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_persona_list" model="ir.ui.view">
        <field name="name">cultiveau.persona.list</field>
        <field name="model">cultiveau.persona</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="resume"/>
                <field name="canal"/>
                <field name="nb_clients"/>
            </list>
        </field>
    </record>

    <record id="view_persona_form" model="ir.ui.view">
        <field name="name">cultiveau.persona.form</field>
        <field name="model">cultiveau.persona</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_clients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="nb_clients" widget="statinfo" string="Clients"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1><field name="resume" placeholder="En une phrase"/></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="couleur" widget="color"/>
                        </group>
                        <group>
                            <field name="canal"/>
                            <field name="moment"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comment on le reconnaît" name="signes"><field name="signes" nolabel="1"/></page>
                        <page string="Comment l'aborder" name="approche"><field name="approche" nolabel="1"/></page>
                        <page string="Les arguments qui portent" name="arguments"><field name="arguments" nolabel="1"/></page>
                        <page string="Les pièges" name="pieges"><field name="pieges" nolabel="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_personas" model="ir.actions.act_window">
        <field name="name">Personas : le guide</field>
        <field name="res_model">cultiveau.persona</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_persona_evaluation_list" model="ir.ui.view">
        <field name="name">cultiveau.persona.evaluation.list</field>
        <field name="model">cultiveau.persona.evaluation</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="persona_id"/>
                <field name="repartition"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="action_persona_evaluations" model="ir.actions.act_window">
        <field name="name">Évaluations de persona</field>
        <field name="res_model">cultiveau.persona.evaluation</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
