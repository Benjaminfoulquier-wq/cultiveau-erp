<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_persona_wizard_form" model="ir.ui.view">
        <field name="name">cultiveau.persona.wizard.form</field>
        <field name="model">cultiveau.persona.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Huit questions sur l'agriculteur, telles qu'on le connaît aujourd'hui : ce sont celles qui, dans l'étude PRISM 2023, distinguent le mieux les cinq profils (Lion, Jaguar, Chat, Tortue, Abeille). Le résultat est un point de départ pour la relation, à refaire quand il change (reprise, nouvelle installation, projet).</p>
                <group>
                    <field name="partner_id" readonly="1"/>
                </group>
                <group>
                    <group>
                        <field name="probleme" widget="radio"/>
                        <field name="achat" widget="radio"/>
                        <field name="relation" widget="radio"/>
                        <field name="strategie" widget="radio"/>
                    </group>
                    <group>
                        <field name="moral" widget="radio"/>
                        <field name="engagement" widget="radio"/>
                        <field name="techno" widget="radio"/>
                        <field name="info" widget="radio"/>
                    </group>
                </group>
                <group>
                    <field name="persona_id" readonly="1"/>
                    <field name="apercu" readonly="1"/>
                </group>
                <footer>
                    <button name="action_valider" type="object" string="Enregistrer le persona" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
