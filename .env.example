# Copier en .env (jamais dans le dépôt). Sur le serveur : /srv/erp/.env, lisible par root seulement.
POSTGRES_PASSWORD=changer-ce-mot-de-passe
# Mot de passe maître d'Odoo (gestion des bases), utilisé par scripts/installer.sh
ODOO_ADMIN_PASSWD=changer-aussi-celui-ci
# Le nom de la base de production
ODOO_DB=cultiveau
# Le domaine public (site Caddy)
DOMAINE=erp.cultiveau.fr
